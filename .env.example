# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False
API_ENVIRONMENT=development
API_USE_FAKE_SENDER=False
API_BYPASS_SUBSCRIPTION_CHECK=False

# Database Settings
DATABASE_BACKEND=supabase

# Supabase Settings
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key
SUPABASE_DB_SCHEMA=public
SUPABASE_PROJECT_REF=your_project_ref
SUPABASE_ANON_KEY=your_supabase_anon_key

# Meta Settings
META_BEARER_TOKEN_ACCESS=your_meta_token
META_VERIFICATION_TOKEN=your_verification_token
META_PHONE_NUMBER_ID=your_phone_number_id
META_VERSION_API=v19.0
META_PHONE_NUMBER=your_phone_number
META_BUSINESS_ACCOUNT_ID=your_business_account_id

# Instagram Settings
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_APP_ID=your_app_id
INSTAGRAM_APP_SECRET=your_app_secret
INSTAGRAM_VERIFY_TOKEN=your_verify_token
INSTAGRAM_API_VERSION=v19.0

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
